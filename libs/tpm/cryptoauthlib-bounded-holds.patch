--- a/lib/hal/hal_all_platforms_kit_hidapi.c
+++ b/lib/hal/hal_all_platforms_kit_hidapi.c
@@ -32,6 +32,50 @@
 
 #include "atca_hal.h"
 #include "hal/kit_protocol.h"
+#include "hal/hal_bounded_io.h"
+
+/* Per thread (SB-6638): the device awaiting the first report of a reply,
+   which may wait for the chip, and the device whose last read timed out,
+   whose reads fail at once until the next send, so calib's response poll
+   does not wait out each of its ~1250 polls. */
+static __thread hid_device * t_reply_dev = NULL;
+static __thread hid_device * t_rx_timed_out = NULL;
+
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+static int (*g_read_hook)(hid_device *, unsigned char *, size_t, int) = NULL;
+static int (*g_write_hook)(hid_device *, const unsigned char *, size_t) = NULL;
+
+void hal_kit_hid_test_set_io(int (*read_hook)(hid_device * dev, unsigned char * data,
+                                              size_t length, int timeout_ms),
+                             int (*write_hook)(hid_device * dev,
+                                               const unsigned char * data, size_t length))
+{
+    g_read_hook = read_hook;
+    g_write_hook = write_hook;
+}
+#endif
+
+static int hal_kit_hid_read(hid_device * dev, unsigned char * data, size_t length, int timeout_ms)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_read_hook)
+    {
+        return g_read_hook(dev, data, length, timeout_ms);
+    }
+#endif
+    return hid_read_timeout(dev, data, length, timeout_ms);
+}
+
+static int hal_kit_hid_write(hid_device * dev, const unsigned char * data, size_t length)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_write_hook)
+    {
+        return g_write_hook(dev, data, length);
+    }
+#endif
+    return hid_write(dev, data, length);
+}
 
