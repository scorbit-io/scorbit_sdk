             {
                 (void)close(hal_data->fd_uart);
                 return ATCA_COMM_FAIL;
             }
 
+            /* Drop a late reply that a failed exchange left queued (SB-6638) */
+            (void)tcflush(hal_data->fd_uart, TCIFLUSH);
+
