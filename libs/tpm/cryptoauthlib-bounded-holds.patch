+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+static int (*g_modem_bits_hook)(int fd, int bits) = NULL;
+
+void hal_uart_test_set_modem_bits(int (*hook)(int fd, int bits))
+{
+    g_modem_bits_hook = hook;
+}
+#endif
+
+static int hal_uart_set_modem_bits(int fd, int * bits)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_modem_bits_hook)
+    {
+        return g_modem_bits_hook(fd, *bits);
+    }
+#endif
+    return ioctl(fd, TIOCMBIS, bits);
+}
+
+/* The tty awaiting the first byte of a reply on this thread: it may wait
+   for the chip to execute, later bytes only for the line (SB-6638). */
+static __thread int t_reply_fd = -1;
+
+/** \brief Wait up to \p timeout_ms for \p events on \p fd. */
+static bool hal_uart_wait(int fd, short events, long timeout_ms)
+{
+    struct pollfd pfd = { fd, events, 0 };
+    struct timespec start;
+    struct timespec now;
+    long left_ms = timeout_ms;
+    int ret;
+
+    (void)clock_gettime(CLOCK_MONOTONIC, &start);
+    while ((-1 == (ret = poll(&pfd, 1, (int)left_ms))) && (EINTR == errno))
+    {
+        (void)clock_gettime(CLOCK_MONOTONIC, &now);
+        left_ms = timeout_ms - ((long)(now.tv_sec - start.tv_sec) * 1000L
+                                + (now.tv_nsec - start.tv_nsec) / 1000000L);
+        left_ms = (0 < left_ms) ? left_ms : 0;
+    }
+    return (1 == ret) && (0 != (pfd.revents & events));
+}
+
+/** \brief Close after a failure, discarding what a stalled pad never took,
+ *         which close() could otherwise wait up to closing_wait for.
+ */
+static void hal_uart_close_file(atca_uart_host_t * hal_data)
+{
+    (void)tcflush(hal_data->fd_uart, TCIOFLUSH);
+    (void)close(hal_data->fd_uart);
+    hal_data->fd_uart = -1;
+    t_reply_fd = -1;
+}
+
 /** \brief Open and configure serial COM Uart
  * \param[out] fd  resulting file descriptor
  *
