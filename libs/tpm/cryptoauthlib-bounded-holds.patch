 #include "atca_hal.h"
 #include "hal/kit_protocol.h"
+#include "hal/hal_bounded_io.h"
+
+#include <time.h>
+
+/* The command in flight on this thread (SB-6638). Once a read for it fails,
+   the rest fail at once, so calib's ~1250 response polls do not each wait. */
+static __thread struct
+{
+    hid_device * dev;
+    int64_t      deadline_ms;    /* end of its whole reply */
+    bool         sending;        /* the last transfer was a send */
+    bool         awaiting_reply; /* no non-NUL reply byte yet */
+    bool         failed;
+} t_cmd;
+
+/* A device whose first wait for a reply timed out: it gets only the shorter
+   wait until it answers again, so a dead pad does not cost 2.5 s per wake.
+   Not per thread: atcaRetry's attempts may run on different threads. */
+static hid_device * g_suspect = NULL;
+
+/* A failed send ends its command: its reply is never read, the next send
+   starts a new one. */
+static void hal_kit_hid_send_failed(void)
+{
+    t_cmd.failed = true;
+    t_cmd.sending = false;
+}
+
+static int64_t hal_kit_hid_now_ms(void)
+{
+    struct timespec now;
+
+    (void)clock_gettime(CLOCK_MONOTONIC, &now);
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+static int (*g_read_hook)(hid_device *, unsigned char *, size_t, int) = NULL;
+static int (*g_write_hook)(hid_device *, const unsigned char *, size_t) = NULL;
+
+void hal_kit_hid_test_set_io(int (*read_hook)(hid_device * dev, unsigned char * data,
+                                              size_t length, int timeout_ms),
+                             int (*write_hook)(hid_device * dev,
+                                               const unsigned char * data, size_t length))
+{
+    g_read_hook = read_hook;
+    g_write_hook = write_hook;
+}
+#endif
+
+static int hal_kit_hid_read(hid_device * dev, unsigned char * data, size_t length, int timeout_ms)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_read_hook)
+    {
+        return g_read_hook(dev, data, length, timeout_ms);
+    }
+#endif
+    return hid_read_timeout(dev, data, length, timeout_ms);
+}
+
+static int hal_kit_hid_write(hid_device * dev, const unsigned char * data, size_t length)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_write_hook)
+    {
+        return g_write_hook(dev, data, length);
+    }
+#endif
+    return hid_write(dev, data, length);
+}
 
