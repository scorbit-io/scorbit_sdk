#!/bin/sh
set -e
CONF=/etc/ld.so.conf.d/scorbit-sdk.conf
RULES=/etc/udev/rules.d/60-scorbit-probes.rules
PROBE_GROUP="@SCORBIT_SDK_PROBE_GROUP@"

# Probes (vendor 0xcafe) and an RP2040 in BOOTSEL (2e8a:0003), which the SDK flashes over
# PICOBOOT, opened by a non-root SDK. This is the only step that needs root, so it lives here.
install_probe_rules() {
  if [ -n "$PROBE_GROUP" ] && ! getent group "$PROBE_GROUP" >/dev/null 2>&1; then
    groupadd --system "$PROBE_GROUP" 2>/dev/null || addgroup -S "$PROBE_GROUP" 2>/dev/null || true
    getent group "$PROBE_GROUP" >/dev/null 2>&1 ||
      echo "scorbit_sdk: could not create group $PROBE_GROUP; probes stay root-only" >&2
  fi
  mkdir -p /etc/udev/rules.d
  {
    echo "# Installed by the scorbit_sdk package: lets the SDK use and flash probes without root."
    echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="cafe", @SCORBIT_SDK_PROBE_ACCESS@'
    echo 'SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0003", @SCORBIT_SDK_PROBE_ACCESS@'
    # Where cdc-acm binds a probe, the SDK talks to it through these instead of libusb.
    echo 'SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="cafe", @SCORBIT_SDK_PROBE_ACCESS@'
  } > "$RULES"
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=cafe || true
    udevadm trigger --subsystem-match=usb --attr-match=idVendor=2e8a --attr-match=idProduct=0003 || true
    udevadm trigger --subsystem-match=tty --sysname-match='ttyACM*' --property-match=ID_VENDOR_ID=cafe || true
  fi
}

if [ "$1" = "configure" ]; then
  mkdir -p /etc/ld.so.conf.d
  echo "@SCORBIT_SDK_LD_SO_PATH@" > "$CONF"
  if [ -d "@SCORBIT_SDK_LIBDIR@" ]; then
    # 777 (not 1777): sticky bit blocks non-root rename/unlink of root-owned .so files.
    chmod 777 "@SCORBIT_SDK_LIBDIR@" || true
  fi
  install_probe_rules || true
fi
ldconfig
