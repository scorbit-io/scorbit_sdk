+/**
+ * \file
+ * \brief Bounds on how long one kit transfer may block on a pad that stopped
+ *        answering, since callers hold the tap pad lock across it (SB-6638).
+ *
+ * Each command's reply is bounded as a whole, and input left from an earlier
+ * command is drained before a new one is sent. A failed tty transfer closes
+ * the tty until the next init. A HID device whose first wait for a reply
+ * timed out gets only the shorter wait until it answers again.
+ *
+ * Copyright (c) 2026 Spinner Systems, Inc. (DBA Scorbit)
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef HAL_BOUNDED_IO_H
+#define HAL_BOUNDED_IO_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** \brief Wait for a tty to take a byte; the libusb transport's write timeout. */
+#define HAL_UART_WRITE_TIMEOUT_MS   (1000)
+
+/** \brief Wait for the first byte (tty) or report (HID) of a reply: calib's
+ *         own 2.5 s limit for a command, so a slow chip clock still answers.
+ */
+#define HAL_KIT_REPLY_TIMEOUT_MS    (2500)
+
+/** \brief Wait for each later byte or report: the tty's VTIME of 0.5 s. */
+#define HAL_KIT_BYTE_TIMEOUT_MS     (500)
+
+/** \brief A command's whole reply, from its first byte sent: the first wait
+ *         plus one more gap, so a pad that trickles bytes cannot stretch it.
+ */
+#define HAL_KIT_COMMAND_TIMEOUT_MS  (HAL_KIT_REPLY_TIMEOUT_MS + HAL_KIT_BYTE_TIMEOUT_MS)
+
+/** \brief Input reports drained before a HID send; upstream had no limit. */
+#define HAL_KIT_HID_MAX_DRAIN       (64)
+
+/** \brief NULs skipped ahead of a kit-UART reply: a full-speed USB packet. */
+#define KIT_MAX_NUL_SKIP            (64u)
+
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+struct hid_device_;
+
+/** \brief Test builds only: the tty HAL raises modem lines through \p hook
+ *         (NULL restores ioctl(TIOCMBIS)), which a pseudo-terminal lacks.
+ */
+void hal_uart_test_set_modem_bits(int (*hook)(int fd, int bits));
+
+/** \brief Test builds only: the HID HAL reads and writes through these hooks
+ *         (NULL restores hid_read_timeout() and hid_write()).
+ */
+void hal_kit_hid_test_set_io(int (*read_hook)(struct hid_device_ * dev, unsigned char * data,
+                                              size_t length, int timeout_ms),
+                             int (*write_hook)(struct hid_device_ * dev,
+                                               const unsigned char * data, size_t length));
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* HAL_BOUNDED_IO_H */
