--- /dev/null
+++ b/lib/hal/hal_tappad_lock.c
@@ -0,0 +1,645 @@
+/**
+ * \file
+ * \brief Cross-process lock serialising access to a tap pad's secure element.
+ *        See hal_tappad_lock.h for the contract.
+ *
+ * Copyright (c) 2026 Spinner Systems, Inc. (DBA Scorbit)
+ * SPDX-License-Identifier: MIT
+ */
+
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE
+#endif
+
+#include "hal_tappad_lock.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#define TAPPAD_LOCK_MAX_PATHS   (4u)
+#define TAPPAD_LOCK_PATH_SIZE   (256u)
+/* Waiters poll with exponential backoff from 1 to 8 ms plus up to 1 ms of
+   jitter, so one polls at least every ~9 ms. */
+#define TAPPAD_POLL_MIN_MS      (1u)
+#define TAPPAD_POLL_MAX_MS      (8u)
+/* After a sequence hold (hal_tappad_lock_sequence) a process leaves the lock
+   free this long before taking it again: twice any waiter's poll interval. The
+   HAL's own per-transfer holds are never spaced out. */
+#define TAPPAD_REACQUIRE_GAP_US (20000u)
+
+static const char * const g_default_paths[] = {
+    "/var/lock/scorbit-tappad.lock",
+    "/run/lock/scorbit-tappad.lock",
+    "/tmp/scorbit-tappad.lock",
+};
+
+/* One slot per candidate path, by its index in the path list. A candidate
+   that names the same file as another holds no fd of its own (flock() is per
+   open file description, so locking one inode through two fds would deadlock
+   this process against itself); it records the inode it resolved to instead,
+   so the post-acquire check can see the alias change. */
+typedef struct
+{
+    int   fd;        /* open lock file, or -1 */
+    bool  alias;     /* no fd: the path named another slot's file */
+    dev_t dev;       /* of the open file, or of the file the alias named */
+    ino_t ino;
+    char  path[TAPPAD_LOCK_PATH_SIZE];
+} tappad_file_t;
+
+/* g_mutex is held by the thread whose outermost hold is active; it also guards
+   every field below except t_depth, which is per thread. A plain mutex plus a
+   per-thread depth behaves as a recursive mutex but can be reset after fork. */
+static pthread_once_t  g_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t g_mutex = PTHREAD_MUTEX_INITIALIZER;
+static __thread int    t_depth = 0;
+static tappad_file_t   g_files[TAPPAD_LOCK_MAX_PATHS];
+static size_t          g_order[TAPPAD_LOCK_MAX_PATHS];   /* slots in lock order */
+static size_t          g_order_count = 0;
+static pid_t           g_pid = 0;
+static bool            g_hold_is_sequence = false;
+static bool            g_last_was_sequence = false;
+static uint64_t        g_released_us = 0;
+static char            g_paths[TAPPAD_LOCK_MAX_PATHS][TAPPAD_LOCK_PATH_SIZE];
+static size_t          g_path_count = 0;
+static bool            g_custom_paths = false;
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+static int (*g_flock_hook)(int fd, int operation) = NULL;
+#endif
+
+static int tappad_flock(int fd, int operation)
+{
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    if (NULL != g_flock_hook)
+    {
+        return g_flock_hook(fd, operation);
+    }
+#endif
+    return flock(fd, operation);
+}
+
+static void tappad_close_file(size_t i)
+{
+    /* Closing an inherited fd does not release a flock the parent holds: the
+       parent still references the same open file description. */
+    if (0 <= g_files[i].fd)
+    {
+        (void)close(g_files[i].fd);
+    }
+    g_files[i].fd = -1;
+    g_files[i].alias = false;
+    g_files[i].path[0] = '\0';
+}
+
+static void tappad_close_all(void)
+{
+    size_t i;
+
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        tappad_close_file(i);
+    }
+    g_order_count = 0;
+}
+
+/* Release the first n locks of g_order, last taken first. */
+static void tappad_unlock_files(size_t n)
+{
+    while (0u < n)
+    {
+        n--;
+        (void)tappad_flock(g_files[g_order[n]].fd, LOCK_UN);
+    }
+}
+
+static void tappad_after_fork_child(void)
+{
+    /* Re-initialising a mutex another (now nonexistent) thread may have held is
+       undefined behaviour by the letter of POSIX, but it is the only way to get
+       a usable mutex back in the child, and is what glibc and macOS support in
+       practice. Only the forking thread survives, and it holds nothing here.
+       There are no prepare/parent handlers, so a fork() racing another thread's
+       acquire may copy half-updated state; the child discards all of it here,
+       so that race is accepted too. */
+    (void)pthread_mutex_init(&g_mutex, NULL);
+    t_depth = 0;
+    tappad_close_all();
+    g_hold_is_sequence = false;
+    g_last_was_sequence = false;
+    g_pid = getpid();
+}
+
+static void tappad_init_once(void)
+{
+    size_t i;
+
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        g_files[i].fd = -1;
+        g_files[i].alias = false;
+        g_files[i].path[0] = '\0';
+    }
+    g_pid = getpid();
+    (void)pthread_atfork(NULL, NULL, tappad_after_fork_child);
+}
+
+/* Monotonic: never stepped by NTP or an RTC-less boot setting the clock. */
+static uint64_t tappad_now_us(void)
+{
+    struct timespec ts;
+
+    (void)clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ((uint64_t)ts.tv_sec * 1000000u) + ((uint64_t)ts.tv_nsec / 1000u);
+}
+
+static void tappad_sleep_us(uint64_t us)
+{
+    struct timespec ts;
+
+    ts.tv_sec = (time_t)(us / 1000000u);
+    ts.tv_nsec = (long)(us % 1000000u) * 1000L;
+    (void)nanosleep(&ts, NULL);
+}
+
+/* Sleep for the current backoff plus up to 1 ms of jitter, then grow it. */
+static void tappad_backoff(uint32_t * backoff_ms)
+{
+    tappad_sleep_us(((uint64_t)*backoff_ms * 1000u) + (tappad_now_us() % 1000u));
+    *backoff_ms = (*backoff_ms * 2u > TAPPAD_POLL_MAX_MS) ? TAPPAD_POLL_MAX_MS : (*backoff_ms * 2u);
+}
+
+static bool tappad_expired(uint64_t start_us, uint32_t timeout_ms)
+{
+    return (tappad_now_us() - start_us) >= ((uint64_t)timeout_ms * 1000u);
+}
+
+/* The candidate lock-file paths, in their fixed order. */
+static size_t tappad_paths(const char * out[TAPPAD_LOCK_MAX_PATHS])
+{
+    size_t i;
+
+    if (g_custom_paths)
+    {
+        for (i = 0; i < g_path_count; i++)
+        {
+            out[i] = g_paths[i];
+        }
+        return g_path_count;
+    }
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+    /* Test builds only (never set for a release build): lets a test harness
+       keep every process it starts off the real lock file. */
+    {
+        const char * env_path = getenv("ATCA_TAPPAD_LOCK_PATH");
+
+        if ((NULL != env_path) && ('\0' != env_path[0]))
+        {
+            out[0] = env_path;
+            return 1;
+        }
+    }
+#endif
+    for (i = 0; i < (sizeof(g_default_paths) / sizeof(g_default_paths[0])); i++)
+    {
+        out[i] = g_default_paths[i];
+    }
+    return i;
+}
+
+static bool tappad_acceptable(const struct stat * st)
+{
+    return S_ISREG(st->st_mode) && (1 == st->st_nlink) && (0666 == (st->st_mode & 07777));
+}
+
+/* Open one candidate without following a symlink planted at it, and without
+   blocking on a FIFO planted at it (O_NONBLOCK). Accept only a plain file with
+   a single link and mode exactly 0666 (no setuid, setgid or sticky bits), so
+   every process, whatever its uid, accepts and refuses the same files. Only a
+   file this call created is chmod'ed. */
+static int tappad_open_path(const char * path, struct stat * st)
+{
+    int fd = -1;
+    int attempt;
+
+    for (attempt = 0; (0 > fd) && (attempt < 2); attempt++)
+    {
+        fd = open(path, O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_NONBLOCK | O_NOCTTY | O_CLOEXEC, 0666);
+        if (0 <= fd)
+        {
+            /* Past the umask, at once: a file left at another mode by a crash
+               here is refused by everyone alike, and the other paths are used. */
+            (void)fchmod(fd, 0666);
+            break;
+        }
+        if (EEXIST != errno)
+        {
+            return -1;
+        }
+        fd = open(path, O_RDWR | O_NOFOLLOW | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+        /* Read-write refused (permissions, a read-only mount, an immutable
+           file): flock() works on a read-only fd. */
+        if ((0 > fd) && ((EACCES == errno) || (EROFS == errno) || (EPERM == errno)))
+        {
+            fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+        }
+        /* Unlinked between the two opens: create it again, once. */
+        if ((0 > fd) && (ENOENT != errno))
+        {
+            return -1;
+        }
+    }
+    if ((0 > fd) || (0 != fstat(fd, st)))
+    {
+        if (0 <= fd)
+        {
+            (void)close(fd);
+        }
+        return -1;
+    }
+    /* Another process may have created it a moment ago and not yet reached its
+       fchmod(): look once more, briefly, before refusing a fresh file. */
+    if (S_ISREG(st->st_mode) && (1 == st->st_nlink) && (0666 != (st->st_mode & 07777))
+        && ((time(NULL) - st->st_ctime) <= 1))
+    {
+        tappad_sleep_us(1000u);
+        (void)fstat(fd, st);
+    }
+    if (!tappad_acceptable(st))
+    {
+        (void)close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+/* Whether slot i's path still names the file it named when last opened or
+   skipped as an alias. */
+static bool tappad_slot_matches_path(size_t i)
+{
+    struct stat st;
+
+    return (0 == lstat(g_files[i].path, &st)) && (st.st_dev == g_files[i].dev)
+           && (st.st_ino == g_files[i].ino);
+}
+
+/* Whether a slot other than skip holds this inode open. */
+static bool tappad_inode_held(dev_t dev, ino_t ino, size_t skip)
+{
+    size_t i;
+
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        if ((i != skip) && (0 <= g_files[i].fd) && (g_files[i].dev == dev) && (g_files[i].ino == ino))
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void tappad_set_alias(size_t i, const char * path, const struct stat * st)
+{
+    g_files[i].alias = true;
+    g_files[i].dev = st->st_dev;
+    g_files[i].ino = st->st_ino;
+    (void)snprintf(g_files[i].path, sizeof(g_files[i].path), "%s", path);
+}
+
+/* Caller holds g_mutex. Keeps every open file that is still the file its path
+   names, drops the rest, opens every candidate that is usable now, is not a
+   file already open through another candidate and is not marked in skip, and
+   sorts the open files into the global lock order. */
+static void tappad_refresh_files(const bool skip[TAPPAD_LOCK_MAX_PATHS])
+{
+    const char * paths[TAPPAD_LOCK_MAX_PATHS];
+    size_t count = tappad_paths(paths);
+    size_t i;
+
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        if (g_files[i].alias)
+        {
+            g_files[i].alias = false;   /* re-derived below */
+            g_files[i].path[0] = '\0';
+        }
+        if ((0 <= g_files[i].fd)
+            && ((i >= count) || (0 != strcmp(g_files[i].path, paths[i])) || !tappad_slot_matches_path(i)))
+        {
+            tappad_close_file(i);
+        }
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        struct stat st;
+        int fd;
+
+        if ((0 <= g_files[i].fd) || skip[i])
+        {
+            continue;
+        }
+        /* A path that names a file already open (e.g. /var/lock symlinked to
+           /run/lock) is recorded as an alias without opening it. */
+        if ((0 == lstat(paths[i], &st)) && tappad_inode_held(st.st_dev, st.st_ino, i))
+        {
+            tappad_set_alias(i, paths[i], &st);
+            continue;
+        }
+        fd = tappad_open_path(paths[i], &st);
+        if (0 > fd)
+        {
+            continue;
+        }
+        if (tappad_inode_held(st.st_dev, st.st_ino, i))
+        {
+            (void)close(fd);
+            tappad_set_alias(i, paths[i], &st);
+            continue;
+        }
+        g_files[i].fd = fd;
+        g_files[i].dev = st.st_dev;
+        g_files[i].ino = st.st_ino;
+        (void)snprintf(g_files[i].path, sizeof(g_files[i].path), "%s", paths[i]);
+    }
+
+    /* Lock order is by (device, inode), not by candidate index, so every
+       process takes the same files in the same order whatever paths it reached
+       them by: no two waiters can wait on each other. */
+    g_order_count = 0;
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        size_t j;
+
+        if (0 > g_files[i].fd)
+        {
+            continue;
+        }
+        j = g_order_count++;
+        while ((0u < j)
+               && ((g_files[g_order[j - 1u]].dev > g_files[i].dev)
+                   || ((g_files[g_order[j - 1u]].dev == g_files[i].dev)
+                       && (g_files[g_order[j - 1u]].ino > g_files[i].ino))))
+        {
+            g_order[j] = g_order[j - 1u];
+            j--;
+        }
+        g_order[j] = i;
+    }
+}
+
+/* flock() not supported on that file system: every process sees the same, so
+   the path can be left out of the hold without splitting it. */
+static bool tappad_flock_unsupported(int error)
+{
+    return (EOPNOTSUPP == error) || (ENOSYS == error) || (EINVAL == error);
+}
+
+/* Caller holds g_mutex. Locks every open file in the global order under one
+   deadline. Returns ATCA_SUCCESS with all of them locked, or ATCA_TAPPAD_BUSY
+   with none locked. */
+static ATCA_STATUS tappad_lock_files(uint64_t start, uint32_t timeout_ms)
+{
+    uint32_t backoff = TAPPAD_POLL_MIN_MS;
+    /* Paths whose file system does not support flock(), left out of this hold
+       (and tried again on the next one). */
+    bool unsupported[TAPPAD_LOCK_MAX_PATHS] = { false };
+
+    for (;;)
+    {
+        size_t n;
+        size_t i;
+        bool restart = false;
+
+        tappad_refresh_files(unsupported);
+
+        for (n = 0; (n < g_order_count) && !restart; n++)
+        {
+            size_t slot = g_order[n];
+
+            while (0 != tappad_flock(g_files[slot].fd, LOCK_EX | LOCK_NB))
+            {
+                if (tappad_flock_unsupported(errno))
+                {
+                    /* Drop this path and start over with the rest. */
+                    tappad_unlock_files(n);
+                    tappad_close_file(slot);
+                    unsupported[slot] = true;
+                    restart = true;
+                    break;
+                }
+                /* EWOULDBLOCK, EINTR and anything transient (ENOLCK, ENOMEM...):
+                   wait, as for a held lock. */
+                if (tappad_expired(start, timeout_ms))
+                {
+                    tappad_unlock_files(n);
+                    return ATCA_TAPPAD_BUSY;
+                }
+                tappad_backoff(&backoff);
+            }
+        }
+        if (restart)
+        {
+            continue;
+        }
+
+        /* A file may have been unlinked or replaced while we waited, or an
+           alias repointed; a lock on an orphaned inode would exclude nobody. */
+        for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+        {
+            if (((0 <= g_files[i].fd) || g_files[i].alias) && !tappad_slot_matches_path(i))
+            {
+                restart = true;
+            }
+        }
+        if (!restart)
+        {
+            return ATCA_SUCCESS;
+        }
+        tappad_unlock_files(g_order_count);
+        if (tappad_expired(start, timeout_ms))
+        {
+            return ATCA_TAPPAD_BUSY;
+        }
+        tappad_backoff(&backoff);
+    }
+}
+
+ATCA_STATUS hal_tappad_lock(uint32_t timeout_ms)
+{
+    uint64_t start;
+    uint32_t backoff = TAPPAD_POLL_MIN_MS;
+
+    (void)pthread_once(&g_once, tappad_init_once);
+
+    if (0 < t_depth)
+    {
+        t_depth++;
+        return ATCA_SUCCESS;
+    }
+
+    /* The in-process step polls with backoff on every platform rather than use
+       pthread_mutex_timedlock(): that needs a CLOCK_REALTIME deadline, which
+       steps at boot on hosts without an RTC, and glibc's default mutex does not
+       queue its waiters in order anyway. */
+    start = tappad_now_us();
+    while (0 != pthread_mutex_trylock(&g_mutex))
+    {
+        if (tappad_expired(start, timeout_ms))
+        {
+            return ATCA_TAPPAD_BUSY;
+        }
+        tappad_backoff(&backoff);
+    }
+
+    /* A child created without running fork handlers (e.g. raw clone). */
+    if (g_pid != getpid())
+    {
+        tappad_close_all();
+        g_pid = getpid();
+    }
+
+    /* Fairness: after a sequence hold, give other processes' pollers a window
+       before this process takes the file locks again, but never past the
+       caller's timeout. */
+    if (g_last_was_sequence)
+    {
+        uint64_t now = tappad_now_us();
+        uint64_t since = now - g_released_us;
+        uint64_t budget_us = (uint64_t)timeout_ms * 1000u;
+        uint64_t left_us = ((now - start) < budget_us) ? (budget_us - (now - start)) : 0u;
+
+        if (since < TAPPAD_REACQUIRE_GAP_US)
+        {
+            uint64_t gap_us = TAPPAD_REACQUIRE_GAP_US - since;
+            tappad_sleep_us((gap_us < left_us) ? gap_us : left_us);
+        }
+    }
+
+    /* With no usable lock file this holds no file lock: in-process exclusion
+       only, rather than fail chip I/O. hal_tappad_lock_path() reports NULL. */
+    if (ATCA_SUCCESS != tappad_lock_files(start, timeout_ms))
+    {
+        (void)pthread_mutex_unlock(&g_mutex);
+        return ATCA_TAPPAD_BUSY;
+    }
+
+    g_hold_is_sequence = false;
+    t_depth = 1;
+    return ATCA_SUCCESS;
+}
+
+ATCA_STATUS hal_tappad_lock_sequence(uint32_t timeout_ms)
+{
+    ATCA_STATUS status = hal_tappad_lock(timeout_ms);
+
+    if (ATCA_SUCCESS == status)
+    {
+        g_hold_is_sequence = true;
+    }
+    return status;
+}
+
+void hal_tappad_unlock(void)
+{
+    if (0 >= t_depth)
+    {
+        return;
+    }
+    if (0 < --t_depth)
+    {
+        return;
+    }
+    tappad_unlock_files(g_order_count);
+    g_released_us = tappad_now_us();
+    g_last_was_sequence = g_hold_is_sequence;
+    g_hold_is_sequence = false;
+    (void)pthread_mutex_unlock(&g_mutex);
+}
+
+int hal_tappad_lock_depth(void)
+{
+    return t_depth;
+}
+
+const char * hal_tappad_lock_path(void)
+{
+    size_t i;
+
+    (void)pthread_once(&g_once, tappad_init_once);
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        if ((0 <= g_files[i].fd) && ('\0' != g_files[i].path[0]))
+        {
+            return g_files[i].path;
+        }
+    }
+    return NULL;
+}
+
+size_t hal_tappad_lock_file_count(void)
+{
+    size_t i;
+    size_t held = 0;
+
+    (void)pthread_once(&g_once, tappad_init_once);
+    for (i = 0; i < TAPPAD_LOCK_MAX_PATHS; i++)
+    {
+        if (0 <= g_files[i].fd)
+        {
+            held++;
+        }
+    }
+    return held;
+}
+
+ATCA_STATUS hal_tappad_lock_set_paths(const char * const * paths, size_t count)
+{
+    size_t i;
+
+    if ((TAPPAD_LOCK_MAX_PATHS < count) || ((NULL == paths) && (0u != count)))
+    {
+        return ATCA_BAD_PARAM;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if ((NULL == paths[i]) || (TAPPAD_LOCK_PATH_SIZE <= strlen(paths[i])))
+        {
+            return ATCA_BAD_PARAM;
+        }
+    }
+
+    (void)pthread_once(&g_once, tappad_init_once);
+    if ((0 < t_depth) || (0 != pthread_mutex_trylock(&g_mutex)))
+    {
+        return ATCA_FUNC_FAIL;
+    }
+
+    tappad_close_all();
+    for (i = 0; i < count; i++)
+    {
+        (void)snprintf(g_paths[i], sizeof(g_paths[i]), "%s", paths[i]);
+    }
+    g_path_count = count;
+    g_custom_paths = (0u != count);
+    g_last_was_sequence = false;
+
+    (void)pthread_mutex_unlock(&g_mutex);
+    return ATCA_SUCCESS;
+}
+
+#ifdef ATCA_TAPPAD_LOCK_ENV_OVERRIDE
+void hal_tappad_lock_test_set_flock(int (*hook)(int fd, int operation))
+{
+    (void)pthread_once(&g_once, tappad_init_once);
+    g_flock_hook = hook;
+}
+#endif
