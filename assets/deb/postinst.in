#!/bin/sh
set -e
CONF=/etc/ld.so.conf.d/scorbit-sdk.conf

# The RPI-RP2 fstab entry breaks boot on BeagleBone Black, so skip it on that board.
# /proc/device-tree/model is the authoritative board id; the cpuinfo Hardware line
# ("Generic AM33XX") is the fallback for the old TI vendor kernels.
is_beaglebone() {
  { cat /proc/device-tree/model /proc/cpuinfo 2>/dev/null || true; } |
    tr -d '\0' | grep -qi 'beaglebone\|am33xx'
}

if [ "$1" = "configure" ]; then
  mkdir -p /etc/ld.so.conf.d
  echo "@SCORBIT_SDK_LD_SO_PATH@" > "$CONF"
  if [ -d "@SCORBIT_SDK_LIBDIR@" ]; then
    # 777 (not 1777): sticky bit blocks non-root rename/unlink of root-owned .so files.
    chmod 777 "@SCORBIT_SDK_LIBDIR@" || true
  fi
  if [ -x "@SCORBIT_SDK_INSTALL_PREFIX@/bin/add-rpi-rp2-fstab.sh" ] && ! is_beaglebone; then
    "@SCORBIT_SDK_INSTALL_PREFIX@/bin/add-rpi-rp2-fstab.sh" add || true
  fi
fi
ldconfig
